[Unit]
Description=Harvey AI Sales Agent Daemon & Dashboard
After=network.target

[Service]
Type=simple
User=harvey
Group=harvey
WorkingDirectory=/opt/harvey
EnvironmentFile=-/opt/harvey/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/harvey/.venv/bin/python -m harvey dashboard --port 5555
Restart=always
RestartSec=5
KillMode=process
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

